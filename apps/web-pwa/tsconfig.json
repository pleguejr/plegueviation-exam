{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "paths": {
      "@plegue/core-engine": ["../../packages/core-engine/src/index.ts"],
      "@plegue/core-engine/*": ["../../packages/core-engine/src/*"],
      "@plegue/shared-sync": ["../../shared/sync/syncMerge.js"]
    }
  },
  "include": ["src", "../../packages/core-engine/src", "../../shared/sync/syncMerge.d.ts"]
}
